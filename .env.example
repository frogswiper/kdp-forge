# kdp-forge configuration
# Copy to `.env` and adjust for your environment.

# Hostname or IP where you'll access the site (must match the Caddy site address).
# Examples: "kdp.local", "192.168.1.20", "localhost"
SITE_HOST=localhost

# Port Caddy listens on.
SITE_PORT=2005

# Ollama HTTP endpoint, as seen from inside the kdp-forge container.
# `host.docker.internal` works on Mac/Windows Docker Desktop and on Linux when
# the compose file maps it (already configured). If your Ollama is elsewhere,
# set this to the real URL, e.g. "http://10.0.0.5:11434".
OLLAMA_URL=http://host.docker.internal:11434

# Default Ollama model used by the AI tools. Any model present in your Ollama
# instance works. Cloud models (-cloud suffix) need internet on the host.
OLLAMA_MODEL=gemma4:31b-cloud
